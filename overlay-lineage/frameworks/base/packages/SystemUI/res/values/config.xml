<resources>


    <!-- Whether key handler sends intent when changing slider position -->
    <string name="config_alertSliderIntent">org.lineageos.settings.device.UPDATE_SLIDER</string>

    <!-- Wattage support to show on custom charging animation-->
    <integer name="config_chargingWattageSupported">100</integer>

    <!-- Actions shown in the advanced restart submenu. Devices may overlay this list. -->
    <string-array name="config_restartActionsList" translatable="false">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_bootloader</item>
        <item>restart_fastboot</item>
    </string-array>

</resources>
